---
---
{%- comment -%} Link the published version once a DOI exists; fall back to arXiv before that. {%- endcomment -%}
{%- if entry.doi -%}
  {%- capture title_href -%}https://doi.org/{{ entry.doi }}{%- endcapture -%}
{%- else -%}
  {%- capture title_href -%}https://arxiv.org/abs/{{ entry.arxiv }}{%- endcapture -%}
{%- endif -%}
{%- if entry.journal -%}
  {%- assign venue = entry.journal -%}
{%- else -%}
  {%- assign venue = entry.booktitle -%}
{%- endif -%}
{%- assign self_marked_last_name = site.scholar.last_name | first | append: '*' -%}
{%- assign is_co_first = false -%}
{%- for author in entry.author_array -%}
  {%- if author.last == self_marked_last_name and site.scholar.first_name contains author.first -%}
    {%- assign is_co_first = true -%}
    {%- break -%}
  {%- endif -%}
{%- endfor -%}
<strong
  ><a href="{{ title_href }}">{{ entry.title }}</a>
  {%- if is_co_first -%}
    <sup title="(co-)first author">*</sup>
  {%- endif -%}</strong
>. <em>{{ venue }}</em>, {{ entry.year }}.
{%- if entry.doi %}
  <a class="cite-doi" href="https://doi.org/{{ entry.doi }}">DOI: {{ entry.doi }}</a>
{%- endif %}
